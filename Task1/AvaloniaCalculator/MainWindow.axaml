<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AvaloniaCalculator.MainWindow"
        Title="Simple Calculator" Width="300" Height="250">
    
    <StackPanel Margin="20" Spacing="10">
        <TextBox Name="txtNum1" Watermark="Number 1" />
        <TextBox Name="txtNum2" Watermark="Number 2" />
        <Button Name="btnCalculate" Content="Calculate" Click="BtnCalculate_Click" />
        <TextBlock Name="lblResult" Text="Result: " FontWeight="Bold" />
    </StackPanel>
</Window>